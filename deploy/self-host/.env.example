# ── Bắt buộc ──────────────────────────────────────────────────────────────
# Sinh 4 giá trị dưới bằng: node scripts/gen-keys.mjs >> .env  (rồi xóa 4 dòng trống này)
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# Domain web app (CORS + link trong email)
SITE_URL=https://spaflow.vn
ADDITIONAL_REDIRECT_URLS=
# Domain công khai của cổng API (nginx) + /auth/v1
API_EXTERNAL_URL=https://api.spaflow.vn/auth/v1
GATEWAY_PORT=8000
POSTGRES_PORT=5432
JWT_EXPIRY=3600

# ── Email (tùy chọn: xác nhận email / quên mật khẩu) ─────────────────────
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=no-reply@spaflow.vn
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=SpaFlow

# ── SMS OTP (đặt lịch bằng số điện thoại) — chọn 1 trong 2 cách ─────────
ENABLE_PHONE_SIGNUP=true
SMS_PROVIDER=twilio
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_MESSAGE_SERVICE_SID=
# Hook gửi SMS qua nhà cung cấp VN (eSMS/SpeedSMS…)
SMS_HOOK_ENABLED=false
SMS_HOOK_URI=
SMS_HOOK_SECRETS=
# Số test không tốn SMS, dạng 84901234567:123456 (để trống trên production)
SMS_TEST_OTP=
