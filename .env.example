# Supabase project (Settings → API). The anon key is public by design — data is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Analytics 4 (optional) — funnel events, see lib/analytics.ts
NEXT_PUBLIC_GA_ID=
# Public site URL for SEO (canonical, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://spaflow.vn
# Link "Viết đánh giá" Google Maps (tùy chọn)
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
