# Sao chép thành migrate/.env (file này KHÔNG commit lên git — chứa mật khẩu)

# Supabase Cloud: Dashboard → Connect → Session pooler (IPv4). Mật khẩu = Database password của project.
SRC_DB_URL=postgresql://postgres.<project-ref>:<mat-khau>@aws-0-<region>.pooler.supabase.com:5432/postgres

# DB mới (chạy script ngay trên máy chủ, cổng 5432 chỉ mở cho 127.0.0.1). Mật khẩu = POSTGRES_PASSWORD trong deploy/self-host/.env
DST_DB_URL=postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5432/postgres
DST_ADMIN_DB_URL=postgresql://supabase_admin:<POSTGRES_PASSWORD>@127.0.0.1:5432/postgres
